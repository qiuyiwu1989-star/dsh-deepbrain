{
  "name": "dsh-deepbrain",
  "version": "0.1.0",
  "description": "DeepBrain (深脑) plugin for DeepSeek Harness: give your agent an organization's second brain — judgments with evidence chains, verbatim-verified quotes, people's historical positions, and 200+ analysis methods it can borrow",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "author": {
    "name": "qiuyiwu",
    "url": "https://github.com/qiuyiwu1989-star"
  },
  "homepage": "https://github.com/qiuyiwu1989-star/dsh-deepbrain#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiuyiwu1989-star/dsh-deepbrain.git"
  },
  "bugs": {
    "url": "https://github.com/qiuyiwu1989-star/dsh-deepbrain/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "second-brain",
    "memory",
    "ai-agent",
    "deepbrain"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsdown && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types scripts/smoke.ts",
    "verify": "pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm build && pnpm verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^24.13.3",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  }
}
